# Análisis multivariado: PCA y agrupamiento automático

El PCA se estima con **40 unidades experimentales de T0–T4** y los cuatro índices (GRP, MGT, GSP y SYN). T5 se excluye exclusivamente del PCA porque MGT, GSP y SYN son indefinidos en ausencia de germinación. El agrupamiento jerárquico de las 40 observaciones se realiza mediante distancias euclidianas sobre las cuatro componentes principales y método Ward.D2; el número de clústeres se selecciona automáticamente por silueta media, dentro de los valores evaluados (2 a 6).

La presentación utiliza **color para el tratamiento**, **forma para la especie** y **contornos para los clústeres automáticos**. El algoritmo de agrupamiento nunca utiliza las etiquetas de tratamiento ni de especie.

## Preparación y ajuste del PCA

```{r}
#| label: pca-preparacion-definitiva

# T5 se excluye: no hubo germinación, por lo que MGT, GSP y SYN
# son índices matemáticamente indefinidos en esas placas.
variables_pca <- c("grp", "mgt", "gsp", "syn")
niveles_pca <- c("T0_0", "T1_1.25", "T2_2.5", "T3_5", "T4_10")

datos_pca <- dt %>%
  dplyr::filter(concentraciones %in% niveles_pca) %>%
  dplyr::select(plots, especies, concentraciones, rep,
                dplyr::all_of(variables_pca)) %>%
  tidyr::drop_na(dplyr::all_of(variables_pca)) %>%
  dplyr::mutate(
    especies = factor(as.character(especies),
                      levels = c("rabanito", "lechuga")),
    concentraciones = factor(as.character(concentraciones),
                             levels = niveles_pca)
  ) %>%
  dplyr::arrange(plots)

stopifnot(nrow(datos_pca) == 40L)
stopifnot(!anyNA(datos_pca$especies), !anyNA(datos_pca$concentraciones))
stopifnot(anyDuplicated(datos_pca$plots) == 0L)

matriz_pca <- datos_pca %>%
  dplyr::select(dplyr::all_of(variables_pca)) %>%
  as.data.frame()

stopifnot(all(vapply(matriz_pca, function(x) all(is.finite(x)), logical(1))))
stopifnot(all(vapply(matriz_pca, stats::sd, numeric(1)) > 0))

# FactoMineR calcula el PCA sobre las 40 observaciones (no sobre medias).
modelo_pca <- FactoMineR::PCA(
  matriz_pca,
  scale.unit = TRUE,
  ncp = length(variables_pca),
  graph = FALSE
)

knitr::kable(
  as.data.frame(modelo_pca$eig), digits = 3,
  caption = "PCA: autovalores y variación explicada"
)

knitr::kable(
  as.data.frame(modelo_pca$var$contrib), digits = 2,
  caption = "PCA: contribución de las variables"
)

knitr::kable(
  round(stats::cor(matriz_pca), 3),
  caption = "Correlación entre índices de germinación"
)
```

## Agrupamiento automático de las 40 unidades

```{r}
#| label: cluster-automatico-definitivo

# Coordenadas de las 40 placas en las CUATRO componentes principales.
coordenadas_pca <- as.data.frame(
  modelo_pca$ind$coord[, seq_along(variables_pca), drop = FALSE]
)
names(coordenadas_pca) <- paste0("PC", seq_along(variables_pca))

ind_pca <- dplyr::bind_cols(
  datos_pca %>%
    dplyr::select(plots, especies, concentraciones, rep),
  coordenadas_pca
)

# Los grupos se calculan SOLO con los índices transformados por PCA.
# Las variables 'especies' y 'concentraciones' NO intervienen aquí.
distancias_ind <- stats::dist(coordenadas_pca, method = "euclidean")
modelo_cluster <- stats::hclust(distancias_ind, method = "ward.D2")

# Se elige automáticamente el número de grupos (k = 2,...,6)
# mediante la mayor silueta media; no se fuerza ningún k particular.
valores_k <- 2:6
siluetas <- vapply(valores_k, function(k) {
  grupos_k <- stats::cutree(modelo_cluster, k = k)
  mean(cluster::silhouette(grupos_k, distancias_ind)[, "sil_width"])
}, numeric(1))

k_elegido <- valores_k[which.max(siluetas)]
ind_pca$grupo <- factor(stats::cutree(modelo_cluster, k = k_elegido))

cat("Número de clústeres seleccionado:", k_elegido, "\n")
cat("Silueta media:", round(max(siluetas), 3), "\n")

knitr::kable(
  data.frame(k = valores_k, silueta_media = siluetas),
  digits = 3,
  caption = "Clúster: selección automática por silueta media"
)

knitr::kable(
  ind_pca %>%
    dplyr::count(grupo, especies, concentraciones, name = "n") %>%
    dplyr::arrange(grupo, especies, concentraciones),
  caption = "Composición de los grupos por especie y tratamiento"
)
```

